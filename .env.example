# Google Apps Script Web App URL for the diagnostic form submission.
# Deploy your Apps Script as a Web App ("Anyone" access) and paste the /exec URL here.
# NOTE: example placeholder — never commit the real deployment URL here.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Shared token the Apps Script validates before writing a row.
# Spam deterrent only — by design this value ships in the frontend bundle, so
# it is NOT real authentication. Keep the real token in a GitHub Actions secret
# (VITE_APPS_SCRIPT_SECRET); use a placeholder here.
VITE_APPS_SCRIPT_SECRET=replace-with-your-shared-token

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# Create a GA4 property at https://analytics.google.com, then paste the ID here.
# Leave empty to use the production fallback baked into src/lib/analytics.ts.
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID (~10 chars, e.g. wul1u06qo7).
# Create a project at https://clarity.microsoft.com, then paste the ID here.
# Leave empty to use the production fallback baked into src/lib/clarity.ts.
VITE_CLARITY_PROJECT_ID=

# Public URL base path. Leave as "/" for root deployments (Lovable, Vercel,
# custom domain). Set to "/<repo-name>/" for GitHub Pages project sites,
# e.g. VITE_BASE_PATH=/groundstate-protocol/. Required only for build, not dev.
VITE_BASE_PATH=/
